# Chaves de demonstração. Troque antes de qualquer uso real.
# O KMS é simulado: VAULT_KEY fica no processo e cifra com AES-256-GCM.
TENANT_KEY=demo-tenant-key-troque
VAULT_KEY=demo-vault-key-troque

ANALYSIS_DB_URL=sqlite:///./data/analysis.db
VAULT_DB_URL=sqlite:///./data/vault.db

# L2 usa urchade/gliner_multi_pii-v1 na CPU, só na primeira chamada.
# Instale com: uv sync --extra ner
# Se o pacote não estiver instalado, a API segue com L1 e L3 e avisa.
ENABLE_NER=true

# API compatível com OpenAI. Não commite a chave.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# true responde nesta máquina, sem rede, só para ver a tela.
LLM_MOCK=false
